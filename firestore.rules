rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile Document and Subcollections
    match /users/{userId} {
      // Only the authenticated user can read or write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Tasks Subcollection: Strictly private to the task owner
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Categories Subcollection: Strictly private to the category owner
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
